Given an integer array nums, rotate the array to the right by k steps, where k is non-negative.


solution


class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        k = k % n; 
        
        int i = 0;
        int j = n - k - 1; 
        int temp;
        while (i < j) {
            temp = nums[i];
            nums[i] = nums[j];
            nums[j] = temp;
            i++;
            j--;
        }
        i = n - k;
        j = n - 1;
        while (i < j) {
            temp = nums[i];
            nums[i] = nums[j];
            nums[j] = temp;
            i++;
            j--;
        }
        i = 0;
        j = n - 1;
        while (i < j) {
            temp = nums[i];
            nums[i] = nums[j];
            nums[j] = temp;
            i++;
            j--;
        }
    }
}
